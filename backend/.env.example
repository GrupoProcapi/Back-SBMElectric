# Database
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_DB=example
DATABASE_USER=root
DATABASE_PASSWORD_FILE=/run/secrets/db-password

# API
API_KEY=your_api_key_here
PORT=8080

# QBO admin endpoints (backend/src/routes/qboAdminRoutes.js) — SEPARATE secret from
# API_KEY. API_KEY ships inside the frontend bundle; QBO_ADMIN_KEY must NEVER reach
# the frontend. Required in every environment, or all admin QBO endpoints reject
# every request (fail-closed). Must be different from API_KEY.
QBO_ADMIN_KEY=your_long_random_admin_only_secret_here

# QuickBooks Online OAuth 2.0
QBO_CLIENT_ID=your_client_id
QBO_CLIENT_SECRET=your_client_secret
QBO_REALM_ID=
QBO_REDIRECT_URI=https://electric-api.shelterbaymarina.com/api/qbo/callback
QBO_ENVIRONMENT=production

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Sync automático de clientes QBO -> DB local (backend/src/services/qboCustomerSyncScheduler.js)
# Corre qboCustomerService.syncCustomers({ dryRun: false, includeInactive: true }) cada X minutos
# para que un cliente creado directo en QuickBooks Online aparezca solo en sbmqb_customers, sin
# tener que pegarle a mano a POST /api/qbo/customers/sync. También requiere que
# QBO_SYNC_APPLY_ENABLED=true (gate de escritura ya existente) para poder escribir de verdad.
# Default: false (deshabilitado, no arranca ningún interval).
QBO_CUSTOMER_SYNC_SCHEDULE_ENABLED=false
# Minutos entre corridas del sync automático. Default: 15 (se usa también si el valor
# seteado no es un número válido).
QBO_CUSTOMER_SYNC_INTERVAL_MINUTES=15
